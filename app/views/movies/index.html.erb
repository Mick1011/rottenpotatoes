<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>


<h1>RottenPotatoes Movies</h1>

<table>
  <!-- Table header -->




  <thead>
  <tr>
    <th class="<%= @sort_column == 'title' ? "sorted-#{@sort_direction}" : '' %>">
      <%= link_to movies_path(sort: "title",
                              direction: @sort_column == "title" && @sort_direction == "asc" ? "desc" : "asc") do %>
        Title <%= @sort_column == "title" ? (@sort_direction == "asc" ? "↑" : "↓") : "" %>
      <% end %>
    </th>

    <th class="<%= @sort_column == 'rating' ? "sorted-#{@sort_direction}" : '' %>">
      <%= link_to movies_path(sort: "rating",
                              direction: @sort_column == "rating" && @sort_direction == "asc" ? "desc" : "asc") do %>
        Rating <%= @sort_column == "rating" ? (@sort_direction == "asc" ? "↑" : "↓") : "" %>
      <% end %>
    </th>

    <th class="<%= @sort_column == 'release_date' ? "sorted-#{@sort_direction}" : '' %>">
      <%= link_to movies_path(sort: "release_date",
                              direction: @sort_column == "release_date" && @sort_direction == "asc" ? "desc" : "asc") do %>
        Release Date <%= @sort_column == "release_date" ? (@sort_direction == "asc" ? "↑" : "↓") : "" %>
      <% end %>
    </th>

    <th>Actions</th>
  </tr>
  </thead>




  <!-- Table body containing the movies -->
  <tbody>
  <% @movies.each do |movie| %>
    <tr>
      <td><%= movie.title %></td>
      <td><%= movie.rating %></td>
      <td><%= movie.release_date&.strftime("%B %d, %Y") %></td>
      <td><%= link_to "Show", movie %></td>
    </tr>
  <% end %>
  </tbody>

  <!-- Table footer -->
  <tfoot>
  <tr>
    <td colspan="4">Total Movies: <%= @movies.count %></td>
  </tr>
  </tfoot>
</table>

<p><%= link_to "Add New Movie", new_movie_path %></p>
